<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ustp.tracker.controller.LoginController" styleClass="login-root">
  <columnConstraints>
    <ColumnConstraints percentWidth="50"/>
    <ColumnConstraints percentWidth="50"/>
  </columnConstraints>
  <rowConstraints><RowConstraints vgrow="ALWAYS"/></rowConstraints>

  <StackPane fx:id="leftPane" styleClass="login-left" GridPane.columnIndex="0">
    <Region styleClass="login-overlay"/>
    <VBox alignment="CENTER" spacing="14">
      <StackPane fx:id="logoHolder"/>
      <Label text="USTP-CDO Task Tracker" styleClass="login-brand"/>
    </VBox>
  </StackPane>

  <StackPane styleClass="login-right" GridPane.columnIndex="1">
    <VBox maxWidth="380" spacing="6" alignment="CENTER_LEFT" maxHeight="-Infinity" styleClass="glass-panel">
      <Label text="Welcome!" styleClass="login-welcome"/>
      <Label text="Students log in using your university username and password." wrapText="true" styleClass="muted"/>
      <Region prefHeight="22"/>
      <Label text="USERNAME / EMAIL" styleClass="field-label"/>
      <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input" onAction="#onLogin"/>
      <Region prefHeight="6"/>
      <Label text="PASSWORD" styleClass="field-label"/>
      <StackPane>
        <PasswordField fx:id="passField" promptText="Enter your password" styleClass="input" onAction="#onLogin"/>
        <TextField fx:id="passVisible" promptText="Enter your password" styleClass="input" onAction="#onLogin"/>
        <Button fx:id="eyeBtn" text="👁" onAction="#toggleEye" styleClass="eye-btn" StackPane.alignment="CENTER_RIGHT"/>
      </StackPane>
      <HBox alignment="CENTER_RIGHT" spacing="14">
        <Hyperlink text="Forgot username?" onAction="#onForgotUsername" styleClass="link-strong"/>
        <Hyperlink text="Forgot password?" onAction="#onForgot" styleClass="link-strong"/>
      </HBox>
      <Label fx:id="errorLbl" styleClass="error-text" wrapText="true"/>
      <Region prefHeight="6"/>
      <Button fx:id="loginBtn" text="Log In" onAction="#onLogin" maxWidth="Infinity" styleClass="primary-btn" defaultButton="true"/>
      <HBox alignment="CENTER" spacing="4">
        <Label text="Don't have an account?" styleClass="muted"/>
        <Hyperlink text="Sign up" onAction="#onSignUp" styleClass="link-strong"/>
      </HBox>
    </VBox>
  </StackPane>
</GridPane>
