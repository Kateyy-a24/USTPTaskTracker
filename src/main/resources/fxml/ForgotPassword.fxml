<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane styleClass="login-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ustp.tracker.controller.ForgotPasswordController">
  <columnConstraints>
    <ColumnConstraints percentWidth="50" />
    <ColumnConstraints percentWidth="50" />
  </columnConstraints>
  <rowConstraints><RowConstraints vgrow="ALWAYS" /></rowConstraints>

  <StackPane fx:id="leftPane" styleClass="login-left" GridPane.columnIndex="0">
    <Region styleClass="login-overlay" />
    <VBox alignment="CENTER" spacing="14">
      <StackPane fx:id="logoHolder" />
      <Label styleClass="login-brand" text="USTP-CDO Task Tracker" />
    </VBox>
  </StackPane>

  <StackPane styleClass="login-right" GridPane.columnIndex="1">
    <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="380" spacing="6" styleClass="glass-panel">
      <Label fx:id="titleLbl" styleClass="login-welcome" text="Forgot Password" />

      <!-- Step 1: identify the account -->
      <VBox fx:id="stepId" spacing="6">
        <Label fx:id="introLbl" styleClass="muted" wrapText="true" />
        <Region prefHeight="16" />
        <Label fx:id="idLabel" styleClass="field-label" text="USERNAME / EMAIL" />
        <TextField fx:id="idField" onAction="#onSendCode" styleClass="input" />
        <Region prefHeight="6" />
        <Button fx:id="sendBtn" maxWidth="Infinity" onAction="#onSendCode" styleClass="primary-btn" text="Send Code" />
      </VBox>

      <!-- Step 2: OTP -->
      <VBox fx:id="stepOtp" spacing="6">
        <Label fx:id="otpInfoLbl" styleClass="muted" wrapText="true" />
        <Region prefHeight="16" />
        <Label styleClass="field-label" text="VERIFICATION CODE" />
        <TextField fx:id="otpField" onAction="#onVerify" promptText="000000" styleClass="input, otp-field" />
        <Region prefHeight="6" />
        <Button fx:id="verifyBtn" maxWidth="Infinity" onAction="#onVerify" styleClass="primary-btn" text="Verify Code" />
        <Button fx:id="resendBtn" maxWidth="Infinity" onAction="#onResend" styleClass="secondary-btn" text="Resend code" />
        <HBox alignment="CENTER"><Hyperlink onAction="#onBackToStart" styleClass="link-strong" text="Back" /></HBox>
      </VBox>

      <!-- Step 3: new password -->
      <VBox fx:id="stepReset" spacing="6">
        <Label styleClass="muted" text="Code verified. Choose your new password." wrapText="true" />
        <Region prefHeight="16" />
        <Label styleClass="field-label" text="NEW PASSWORD" />
        <PasswordField fx:id="newPassField" promptText="At least 8 characters" styleClass="input" />
        <Label styleClass="field-label" text="CONFIRM PASSWORD" />
        <PasswordField fx:id="confirmField" onAction="#onReset" promptText="Re-enter password" styleClass="input" />
        <Region prefHeight="6" />
        <Button maxWidth="Infinity" onAction="#onReset" styleClass="primary-btn" text="Reset Password" />
      </VBox>

      <!-- Step 4 (username flow): show the username -->
      <VBox fx:id="stepResult" spacing="6">
        <Label styleClass="muted" text="Code verified. Your username is:" wrapText="true" />
        <Label fx:id="resultLbl" styleClass="login-welcome" wrapText="true" />
        <Region prefHeight="10" />
        <Button maxWidth="Infinity" onAction="#onBack" styleClass="primary-btn" text="Back to Login" />
        <Button maxWidth="Infinity" onAction="#onAlsoResetPassword" styleClass="secondary-btn" text="I also forgot my password" />
      </VBox>

      <Label fx:id="errorLbl" styleClass="error-text" wrapText="true" />
      <HBox alignment="CENTER" spacing="4">
        <Label styleClass="muted" text="Remembered it?" />
        <Hyperlink onAction="#onBack" styleClass="link-strong" text="Back to login" />
      </HBox>
    </VBox>
  </StackPane>
   <AmbientLight color="CHARTREUSE" lightOn="true" />
   <AnchorPane prefHeight="200.0" prefWidth="200.0" />
   <Accordion />
   <Accordion />
   <AnchorPane prefHeight="200.0" prefWidth="200.0" />
</GridPane>
