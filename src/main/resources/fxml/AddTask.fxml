<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ustp.tracker.controller.AddTaskController">
  <VBox styleClass="card" spacing="12" maxWidth="900">
    <HBox spacing="16">
      <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Task Name" styleClass="form-label"/><TextField fx:id="nameField" promptText="Enter task name" styleClass="input" maxWidth="Infinity"/></VBox>
      <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Subject" styleClass="form-label"/><ComboBox fx:id="subjectBox" editable="true" promptText="Select subject" styleClass="input" maxWidth="Infinity"/></VBox>
    </HBox>
    <VBox spacing="5"><Label text="Description" styleClass="form-label"/><TextArea fx:id="descArea" promptText="Enter task description (Optional)" prefRowCount="4" wrapText="true" styleClass="input"/></VBox>
    <HBox spacing="16">
      <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Deadline" styleClass="form-label"/><DatePicker fx:id="deadlinePicker" promptText="mm/dd/yyyy" styleClass="input" maxWidth="Infinity"/></VBox>
      <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Status" styleClass="form-label"/><ComboBox fx:id="statusBox" styleClass="input" maxWidth="Infinity"/></VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_RIGHT">
      <Button text="Cancel" onAction="#onCancel" styleClass="secondary-btn"/>
      <Button fx:id="saveBtn" text="Save Task" onAction="#onSave" styleClass="primary-btn"/>
    </HBox>
  </VBox>
</VBox>
